import { View, Text, ScrollView, Image, StyleSheet } from 'react-native';
{{#if hasProfileLinks}}
import { useRouter } from 'expo-router';
{{/if}}
import { ScreenWrapper, AppButton, AppCard, LoadingSpinner } from '../../components';
import { makeStyles, typography, spacing } from '../../theme';
import { useGetProfileQuery } from './api';
import { useAuthStore } from '../../store/authStore';
import { useTranslation } from '../../i18n';

export default function ProfileScreen() {
  const styles = useStyles();
  const { t } = useTranslation();
{{#if hasProfileLinks}}
  const router = useRouter();
{{/if}}
  const { data: profile, isLoading } = useGetProfileQuery();
  const logout = useAuthStore((state) => state.logout);
  const avatarSource = { uri: profile?.avatar || 'https://i.pravatar.cc/150?img=68' };

  const handleLogout = () => {
    logout();
{{#if hasSignIn}}
    router.replace('/(auth)/signin');
{{/if}}
  };

  if (isLoading) return <LoadingSpinner fullScreen message={t('profile.loading')} />;

  return (
    <ScreenWrapper>
      <ScrollView contentContainerStyle={styles.scrollContent}>
        <View style={styles.avatarSection}>
          <Image source={avatarSource} style={styles.avatar} />
          <Text style={styles.name}>{profile?.name || t('common.user')}</Text>
          <Text style={styles.email}>{profile?.email}</Text>
          {profile?.bio && <Text style={styles.bio}>{profile.bio}</Text>}
        </View>

        <AppCard style={styles.infoCard}>
          <InfoRow label={`📧 ${t('common.email')}`} value={profile?.email || ''} />
          <InfoRow label={`📱 ${t('common.phone')}`} value={profile?.phone || t('common.notSet')} />
          <InfoRow label={`📍 ${t('common.location')}`} value={profile?.location || t('common.notSet')} />
          <InfoRow
            label={`📅 ${t('common.joined')}`}
            value={profile?.joinedDate ? new Date(profile.joinedDate).toLocaleDateString() : ''}
            isLast
          />
        </AppCard>

        <View style={styles.actions}>
{{#if hasSettings}}
          <AppButton
            title={t('common.settings')}
            onPress={() => router.push('/(main)/settings')}
            variant="outline"
          />
{{/if}}
          <AppButton
            title={t('common.signOut')}
            onPress={handleLogout}
            variant="ghost"
            textStyle={styles.signOut}
          />
        </View>
      </ScrollView>
    </ScreenWrapper>
  );
}

function InfoRow({ label, value, isLast = false }: { label: string; value: string; isLast?: boolean }) {
  const infoStyles = useInfoStyles();
  return (
    <View style={[infoStyles.row, !isLast && infoStyles.border]}>
      <Text style={infoStyles.label}>{label}</Text>
      <Text style={infoStyles.value}>{value}</Text>
    </View>
  );
}

const useStyles = makeStyles((colors) => StyleSheet.create({
  scrollContent: {
    padding: spacing.lg,
    paddingBottom: spacing.xxl,
  },
  avatarSection: {
    alignItems: 'center',
    marginBottom: spacing.xl,
  },
  avatar: {
    width: 100,
    height: 100,
    borderRadius: 50,
    borderWidth: 3,
    borderColor: colors.primary,
    marginBottom: spacing.md,
  },
  name: {
    ...typography.h2,
    color: colors.textPrimary,
  },
  email: {
    ...typography.body,
    color: colors.textSecondary,
    marginTop: spacing.xs,
  },
  bio: {
    ...typography.bodySmall,
    color: colors.textMuted,
    textAlign: 'center',
    marginTop: spacing.sm,
    paddingHorizontal: spacing.lg,
  },
  infoCard: {
    marginBottom: spacing.lg,
  },
  actions: { gap: spacing.sm },
  signOut: { color: colors.error },
}));

const useInfoStyles = makeStyles((colors) => StyleSheet.create({
  row: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    paddingVertical: spacing.md,
  },
  border: {
    borderBottomWidth: 1,
    borderBottomColor: colors.border,
  },
  label: {
    ...typography.label,
    color: colors.textSecondary,
  },
  value: {
    ...typography.body,
    color: colors.textPrimary,
    flex: 1,
    textAlign: 'right',
  },
}));
