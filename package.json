{
  "name": "mobile-app-starter-kit",
  "version": "2.0.0",
  "description": "CLI tool to generate production-ready mobile app boilerplate for Expo React Native, Flutter, and KMP with selectable screens and best-practice architecture.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mobile-app-starter-kit": "dist/index.js",
    "mask": "dist/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mobile",
    "boilerplate",
    "starter-kit",
    "expo",
    "react-native",
    "flutter",
    "kmp",
    "kotlin-multiplatform",
    "cli",
    "scaffold",
    "generator"
  ],
  "author": "Mehedi Hassan Piash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piashcse/mobile-app-starter-kit.git"
  },
  "bugs": {
    "url": "https://github.com/piashcse/mobile-app-starter-kit/issues"
  },
  "homepage": "https://github.com/piashcse/mobile-app-starter-kit#readme",
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "fs-extra": "^11.4.1",
    "handlebars": "^4.7.10",
    "inquirer": "^14.3.0",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
